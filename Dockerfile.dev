# Dockerfile otimizado para desenvolvimento
FROM eclipse-temurin:21-jdk-jammy

# Instalar dependências de desenvolvimento
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    vim \
    git \
    && rm -rf /var/lib/apt/lists/*

# Instalar Maven
ARG MAVEN_VERSION=3.9.5
RUN wget https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz \
    && tar -xzf apache-maven-${MAVEN_VERSION}-bin.tar.gz -C /opt \
    && ln -s /opt/apache-maven-${MAVEN_VERSION} /opt/maven \
    && rm apache-maven-${MAVEN_VERSION}-bin.tar.gz

ENV MAVEN_HOME=/opt/maven
ENV PATH=${MAVEN_HOME}/bin:${PATH}

# Criar usuário de desenvolvimento
RUN groupadd -r devuser && useradd -r -g devuser -s /bin/bash devuser
RUN mkdir -p /home/devuser && chown devuser:devuser /home/devuser

# Set working directory
WORKDIR /app

# Copy Maven files primeiro para cachear dependências
COPY pom.xml .

# Baixar todas as dependências (essa camada será cacheada)
RUN mvn dependency:resolve dependency:resolve-plugins -B

# Configurar para desenvolvimento com hot reload
ENV SPRING_PROFILES_ACTIVE=dev
ENV SPRING_DEVTOOLS_RESTART_ENABLED=true
ENV SPRING_DEVTOOLS_LIVERELOAD_ENABLED=true

# Expor porta da aplicação, porta do LiveReload e porta de debug
EXPOSE 8080 35729 5005

# Comando para desenvolvimento (com hot reload e debug)
CMD ["mvn", "spring-boot:run", "-Dspring-boot.run.jvmArguments=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"]

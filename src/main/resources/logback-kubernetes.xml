<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Configuração do Logback para ambiente Kubernetes -->
    <!-- Apenas console output - logs são coletados pelo Kubernetes -->

    <springProperty scope="context" name="application.name" source="spring.application.name" defaultValue="revenda-veiculos"/>

    <!-- Pattern de log otimizado para Kubernetes -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <!-- Console Appender - Único appender necessário no Kubernetes -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Loggers da aplicação -->
    <logger name="org.com.revenda" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Logger do Spring Framework -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>

    <!-- Logger do Hibernate -->
    <logger name="org.hibernate" level="INFO"/>
    <logger name="org.hibernate.SQL" level="DEBUG"/>

    <!-- Logger do HikariCP -->
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

